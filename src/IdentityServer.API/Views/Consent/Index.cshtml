@model ConsentViewModel
@{
    ViewData["Title"] = "Authorize " + Model.ClientName;
    var initials = string.Concat(Model.ClientName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(w => char.ToUpperInvariant(w[0])));
    var userInitial = string.IsNullOrEmpty(Model.Username) ? "?" : Model.Username[..1].ToUpperInvariant();

    string Icon(string scope) => scope switch
    {
        "openid" => "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><circle cx=\"9\" cy=\"11\" r=\"2\"/><path d=\"M6 16c.6-1.4 1.7-2 3-2s2.4.6 3 2\"/><path d=\"M15 10h3\"/><path d=\"M15 13h3\"/>",
        "profile" => "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 3.6-7 8-7s8 3 8 7\"/>",
        "email" => "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/>",
        "offline_access" => "<path d=\"M21 12a9 9 0 1 1-3-6.7\"/><path d=\"M21 4v5h-5\"/>",
        "phone" => "<path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2\"/>",
        "address" => "<path d=\"M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/>",
        _ => "<circle cx=\"12\" cy=\"12\" r=\"8\"/>"
    };
}

<section class="card wide">
    <div class="app-row">
        <div class="app-avatar" aria-hidden="true">@initials</div>
        <svg class="link-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M7 12h10"/><path d="m13 8 4 4-4 4"/>
        </svg>
        <div class="app-avatar" style="background:#0f172a;color:#fff" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z"/>
            </svg>
        </div>
    </div>

    <h1><strong>@Model.ClientName</strong> wants to access your account</h1>
    <p class="lead">Review what this application is requesting before you continue.</p>

    <div class="user-chip">
        <span class="avatar">@userInitial</span>
        <div>
            <div><strong>@Model.Username</strong></div>
            <div class="muted">@Model.Email</div>
        </div>
    </div>

    <p class="section-label">This will allow @Model.ClientName to</p>
    <ul class="scopes">
        @foreach (var scope in Model.Scopes)
        {
            <li>
                <span class="scope-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        @Html.Raw(Icon(scope.Name))
                    </svg>
                </span>
                <div>
                    <div class="scope-title">
                        @scope.DisplayName
                        @if (scope.Required) { <span class="badge">Required</span> }
                    </div>
                    @if (!string.IsNullOrEmpty(scope.Description))
                    {
                        <div class="scope-desc">@scope.Description</div>
                    }
                    <div class="scope-name">@scope.Name</div>
                </div>
            </li>
        }
    </ul>

    <form method="post" asp-controller="Consent" asp-action="Submit">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div class="actions">
            <button type="submit" name="decision" value="deny" class="btn btn-secondary">Deny</button>
            <button type="submit" name="decision" value="allow" class="btn btn-primary">Allow</button>
        </div>
    </form>

    <p class="fineprint">
        After you allow access you will be redirected to <code>@Model.RedirectUri</code>.
    </p>
</section>
